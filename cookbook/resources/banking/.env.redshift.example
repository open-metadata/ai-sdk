# Banking demo — Redshift target
#
#   cp .env.redshift.example .env.redshift
#   # fill in the blanks, then
#   set -a && source .env.redshift && set +a
#   make all

export WAREHOUSE=redshift

# ── AWS / S3 ──────────────────────────────────────────────────────────────
export AWS_REGION=us-east-1
export BANKING_S3_BUCKET=my-banking-demo-bucket
export BANKING_S3_PREFIX=raw
# Only needed when the bucket and the cluster live in different regions.
# export BANKING_S3_REGION=eu-west-1

# ── Redshift ──────────────────────────────────────────────────────────────
export REDSHIFT_HOST=my-cluster.abc123.us-east-1.redshift.amazonaws.com
export REDSHIFT_PORT=5439
export REDSHIFT_DATABASE=dev
export REDSHIFT_USER=admin
export REDSHIFT_PASSWORD=change-me
# IAM role attached to the cluster, used by COPY to read the bucket.
export REDSHIFT_IAM_ROLE=arn:aws:iam::000000000000:role/RedshiftS3Read

# ── OpenMetadata / Collate ────────────────────────────────────────────────
export AI_SDK_HOST=https://your-instance.getcollate.io
export AI_SDK_TOKEN=your-jwt-token

# Service names in OpenMetadata. Defaults derive from WAREHOUSE; override to
# run both targets against one instance under different names.
# export BANKING_DB_SERVICE=banking-redshift
# export BANKING_BI_SERVICE=banking-superset-redshift

# ── Superset (local docker stack) ─────────────────────────────────────────
export SUPERSET_URL=http://localhost:8088
export SUPERSET_ADMIN_USER=admin
export SUPERSET_ADMIN_PASSWORD='BankAdmin123!'
export SUPERSET_ADMIN_EMAIL=admin@bank.demo
