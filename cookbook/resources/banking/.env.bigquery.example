# Banking demo — BigQuery target
#
#   cp .env.bigquery.example .env.bigquery
#   # fill in the blanks, then
#   set -a && source .env.bigquery && set +a
#   WAREHOUSE=bigquery make all

export WAREHOUSE=bigquery

# ── GCP ───────────────────────────────────────────────────────────────────
export BANKING_GCP_PROJECT=my-gcp-project
export GOOGLE_APPLICATION_CREDENTIALS="$HOME/keys/banking-sa.json"
# Must match the `location` in dbt/profiles.yml's bigquery target.
export BANKING_BQ_LOCATION=US

# The bq CLI reads gcloud's credential store, not the variable above. Run once:
#   gcloud auth activate-service-account --key-file="$GOOGLE_APPLICATION_CREDENTIALS"

# ── OpenMetadata / Collate ────────────────────────────────────────────────
export AI_SDK_HOST=https://your-instance.getcollate.io
export AI_SDK_TOKEN=your-jwt-token

# Service names in OpenMetadata. Defaults derive from WAREHOUSE; override to
# run both targets against one instance under different names.
# export BANKING_DB_SERVICE=banking-bigquery
# export BANKING_BI_SERVICE=banking-superset-bigquery

# ── Superset (local docker stack) ─────────────────────────────────────────
export SUPERSET_URL=http://localhost:8088
export SUPERSET_ADMIN_USER=admin
export SUPERSET_ADMIN_PASSWORD='BankAdmin123!'
export SUPERSET_ADMIN_EMAIL=admin@bank.demo
