# Environment variables for the local Superset stack.
# Copy this file to `.env` in the same directory before running
# `docker compose up`, and edit the values as needed.

# Used to sign session cookies. Must be a long random string. You can
# generate one with: `openssl rand -base64 42`.
SUPERSET_SECRET_KEY=thisISaSECRET_1234567890_changeMe

# Initial admin user created the first time the stack boots. The
# `setup_superset.sh` script logs in with these credentials, so keep them
# in sync if you change them.
SUPERSET_ADMIN_EMAIL=admin@bank.demo
SUPERSET_ADMIN_PASSWORD=BankAdmin123!
