# Copy this file to .env (gitignored) and fill in real values.
# One KEY=value per line. Never commit .env.

AI_SDK_HOST=http://localhost:8585

# Admin token — only explore_context_endpoint.ipynb and setup_demo.py need this.
AI_SDK_TOKEN=

# One token per demo user. `python setup_demo.py` prints both.
DEMO_COMPLIANCE_TOKEN=
DEMO_ENGINEER_TOKEN=

# Required only for the optional agent cells.
OPENAI_API_KEY=

# Optional:
# DEMO_MODEL=openai:gpt-4o
# DEMO_TABLE_FQN=jaffle shop.jaffle_shop.marts_core.dim_customers
